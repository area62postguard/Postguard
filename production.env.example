# PostGuard production configuration — values only belong in Render Environment
POSTGUARD_ENV=production
POSTGUARD_SECRET=<32+ character random secret>
POSTGUARD_ADMIN_EMAIL=<admin email>
DATABASE_URL=<Render PostgreSQL internal URL>
POSTGUARD_PUBLIC_URL=https://your-postguard-domain.example

# Transactional email (generic SMTP)
POSTGUARD_SMTP_HOST=smtp.example.com
POSTGUARD_SMTP_PORT=587
POSTGUARD_SMTP_USERNAME=<smtp username>
POSTGUARD_SMTP_PASSWORD=<smtp password>
POSTGUARD_EMAIL_FROM=PostGuard <security@example.com>
POSTGUARD_SMTP_SSL=0

# Admin MFA
POSTGUARD_REQUIRE_ADMIN_MFA=1

# Set each to 1 only after the real operational task has been completed
POSTGUARD_BACKUPS_CONFIRMED=0
POSTGUARD_RESTORE_TEST_CONFIRMED=0
POSTGUARD_LEGAL_REVIEW_CONFIRMED=0
POSTGUARD_SECURITY_TEST_CONFIRMED=0
POSTGUARD_MONITORING_CONFIRMED=0
POSTGUARD_VISION_AI_CONFIRMED=0
POSTGUARD_SOCIAL_OAUTH_CONFIRMED=0

# Transactional email via Resend HTTPS API (preferred)
POSTGUARD_RESEND_API_KEY=
POSTGUARD_EMAIL_FROM=PostGuard <security@postguard.uk>

# Paid registration (Stripe Checkout)
POSTGUARD_STRIPE_SECRET_KEY=
POSTGUARD_STRIPE_PRICE_PERSONAL=
POSTGUARD_STRIPE_PRICE_EXECUTIVE=
POSTGUARD_STRIPE_PRICE_VIP=

# Stripe webhook signing secret (do not commit real value)
POSTGUARD_STRIPE_WEBHOOK_SECRET=

# Optional complimentary access code. Use a random value of at least 12 characters.
POSTGUARD_FREE_ACCESS_CODE=
